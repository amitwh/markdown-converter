{
  "name": "markdown-converter",
  "version": "4.17.2",
  "description": "Professional Markdown editor and universal file converter with PDF editing, batch processing, and syntax highlighting",
  "main": "src/main.js",
  "desktopName": "MarkdownConverter",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node scripts/build-flowchart-editor.js && node scripts/build-icons.js && electron .",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "build": "electron-builder --config electron-builder.config.js",
    "build:win": "electron-builder --config electron-builder.config.js --win",
    "build:win-signed": "cross-env CSC_LINK=code-signing-cert.pfx electron-builder --config electron-builder.config.js --win",
    "build:win-unsigned": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --config electron-builder.config.js --win",
    "create-cert": "powershell -ExecutionPolicy Bypass -File scripts/create-selfsigned-cert.ps1",
    "build:mac": "electron-builder --config electron-builder.config.js --mac",
    "build:linux": "electron-builder --config electron-builder.config.js --linux",
    "build:linux-ci": "electron-builder --config electron-builder.config.js --linux deb AppImage",
    "build:local": "electron-builder --config electron-builder.config.js --linux --win",
    "dist": "electron-builder --config electron-builder.config.js --publish=never",
    "dist:all": "electron-builder --config electron-builder.config.js -mwl",
    "download-tools": "node scripts/download-tools.js",
    "bundle:markitdown": "node scripts/bundle-markitdown.js",
    "build:flowchart-editor": "node scripts/build-flowchart-editor.js",
    "release:local": "node scripts/release-local.js",
    "build:deb:local": "node scripts/release-local.js --no-git --deb-only",
    "generate-icons": "node scripts/generate-icons.js",
    "build:icons": "node scripts/build-icons.js"
  },
  "keywords": [
    "markdown",
    "pandoc",
    "converter",
    "editor",
    "pdf",
    "audio",
    "video",
    "image"
  ],
  "author": "ConcreteInfo <amit.wh@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/amitwh/markdown-converter"
  },
  "devDependencies": {
    "@maxgraph/core": "^0.25.2",
    "cross-env": "^10.1.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lucide": "^1.77.0",
    "prettier": "^3.10.1"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.15",
    "@replit/codemirror-vim": "^6.4.0",
    "dompurify": "^3.4.18",
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0",
    "figlet": "^1.12.0",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "marked": "^18.2.1",
    "marked-footnote": "^1.4.0",
    "marked-highlight": "^2.2.4",
    "mermaid": "^12.3.0",
    "pdfjs-dist": "^6.5.438",
    "pizzip": "^3.3.0",
    "sharp": "^0.35.5",
    "simple-git": "^4.1.0"
  },
  "overrides": {
    "nth-check": "^2.1.1",
    "lodash.pick": "npm:lodash@^4.17.21",
    "lodash-es": "^4.18.1",
    "lodash": "^4.17.21"
  },
  "allowScripts": {
    "ffmpeg-static": true
  },
  "buildInfo": {
    "date": "2026-11-21",
    "commit": "a517dd4",
    "electron": "45.4.1"
  }
}
